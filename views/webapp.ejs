<style>
/* Import Space Grotesk from Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&display=swap');

/* Web App Hero - Blue Gradient Background Override */
.webapp-hero {
    background: linear-gradient(135deg, #3399ff, #0066cc, #003d7a);
}

/* ========================================
   TAGLINE STYLING - Statement Line (Style B) with Typewriter Animation
   ======================================== */
.webapp-tagline {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 23px;
    font-weight: 700;
    color: #0066cc;
    letter-spacing: 0.5px;
    margin-top: 30px;
    line-height: 1.5;
    text-align: center;
    min-height: 35px; /* Prevent layout shift during typewriter */
}

/* Blinking cursor for typewriter effect */
.webapp-tagline.typing::after {
    content: '|';
    animation: blink 0.7s infinite;
    margin-left: 2px;
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
}

/* Mobile responsive for tagline */
@media (max-width: 767px) {
    .webapp-tagline {
        font-size: 18px;
        letter-spacing: 0.3px;
        margin-top: 20px;
        min-height: 28px;
    }
}

/* Image Animation - Slide In + Float */
@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(100px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
}

.webapp-hero .hero-image img {
    opacity: 1;
    animation: slideInRight 0.8s ease-out, float 3s ease-in-out 1s infinite;
}

/* Text Animations - Cascade Effect */
@keyframes fadeInLeft {
    from {
        opacity: 0;
        transform: translateX(-30px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Hero Text Animation */
.webapp-hero .hero-text h1 {
    animation: fadeInLeft 0.8s ease-out;
}

.webapp-hero .hero-subtitle {
    animation: fadeInLeft 0.8s ease-out 0.2s both;
}

/* Feature Pills */
.feature-pills {
    display: flex;
    gap: 12px;
    margin: 24px 0;
    flex-wrap: wrap;
}

.feature-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 8px 16px;
    border-radius: 20px;
    color: white;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
}

/* Pill Slide Up Animation with Stagger */
.feature-pill:nth-child(1) {
    animation: slideUp 0.6s ease-out 0.4s both;
}

.feature-pill:nth-child(2) {
    animation: slideUp 0.6s ease-out 0.6s both;
}

.feature-pill:nth-child(3) {
    animation: slideUp 0.6s ease-out 0.8s both;
}

.feature-pill:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
}

.feature-pill i {
    color: var(--success-green);
    font-size: 14px;
}

/* Buttons Animation */
.webapp-hero .hero-cta-group {
    animation: fadeInLeft 0.8s ease-out 1s both;
}

/* White Outline Button */
.btn-outline-white {
    background: transparent;
    color: white;
    border: 2px solid white;
}

.btn-outline-white:hover {
    background: white;
    color: var(--primary-blue);
}

/* Mobile Responsive */
@media (max-width: 767px) {
    .feature-pills {
        justify-content: center;
        gap: 8px;
    }

    .feature-pill {
        font-size: 12px;
        padding: 6px 20px;
    }
}

/* ========================================
   INTRO SECTION - Image on Left
   ======================================== */

/* Solid gray background (same as Section 3) */
.intro-section {
    background: var(--gray-50);
}

/* Fix opacity issue - make image visible immediately */
.intro-section .hero-image img {
    opacity: 1;
    animation: slideInLeft 0.8s ease-out, float 3s ease-in-out 1s infinite;
}

@keyframes slideInLeft {
    from {
        opacity: 0;
        transform: translateX(-100px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* Text justification for neat edges */
.intro-section .section-description {
    text-align: justify;
    text-align-last: left;
}

/* Desktop only: Flip layout (image left, text right) */
@media (min-width: 1025px) {
    .intro-section .hero-content {
        flex-direction: row-reverse;
    }
}

/* Mobile: Keep normal order (image on top, text below) */
@media (max-width: 1024px) {
    .intro-section .hero-content {
        flex-direction: column;
    }

    .intro-section .hero-image {
        order: -1;  /* Image on top */
        margin-bottom: 40px;
    }
}



/* ========================================
   SCROLL ANIMATIONS FOR NEW SECTIONS
   ======================================== */

/* Keyframe for fade up animation */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Section Headers - Hidden by default */
.section-header .section-subtitle {
    opacity: 0;
}

.section-header .section-title {
    opacity: 0;
}

.section-header .section-description {
    opacity: 0;
}

/* Section Headers - Animate when visible */
.section-header.animate .section-subtitle {
    animation: fadeInUp 0.6s ease-out forwards;
}

.section-header.animate .section-title {
    animation: fadeInUp 0.6s ease-out 0.15s both;
}

.section-header.animate .section-description {
    animation: fadeInUp 0.6s ease-out 0.3s both;
}

/* Benefit Items - Hidden by default */
.benefit-item {
    opacity: 0;
}

/* Benefit Items - Animate when visible */
.benefit-item.animate {
    animation: fadeInUp 0.6s ease-out forwards;
}
</style>

<script>
    // Scroll Animation Observer for webapp.ejs
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('animate');
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    // Typewriter Effect Function
    function typewriterEffect(element, text, speed = 60) {
        element.textContent = ''; // Clear existing text
        element.classList.add('typing');
        let index = 0;

        const type = () => {
            if (index < text.length) {
                element.textContent += text.charAt(index);
                index++;
                setTimeout(type, speed);
            } else {
                // Typing complete - remove cursor
                element.classList.remove('typing');
            }
        };

        type();
    }

    // Tagline Observer (separate for typewriter effect)
    const taglineObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const tagline = entry.target;
                const originalText = tagline.textContent;
                typewriterEffect(tagline, originalText, 60);
                taglineObserver.unobserve(tagline);
            }
        });
    }, observerOptions);

    // Wait for DOM to load
    document.addEventListener('DOMContentLoaded', function() {
        // Observe intro section header (inside hero-text)
        const introSectionHeader = document.querySelector('.intro-section .section-header');
        if (introSectionHeader) {
            observer.observe(introSectionHeader);
        }

        // Observe tagline for typewriter effect
        const tagline = document.querySelector('.intro-section .webapp-tagline');
        if (tagline) {
            taglineObserver.observe(tagline);
        }

        // Observe all other section headers
        const sectionHeaders = document.querySelectorAll('.why-choose-section .section-header, .services-section .section-header');
        sectionHeaders.forEach(header => {
            observer.observe(header);
        });

        // Observe benefit items with stagger
        const benefitItems = document.querySelectorAll('.benefit-item');
        benefitItems.forEach((item, index) => {
            item.style.animationDelay = `${index * 0.1}s`;
            observer.observe(item);
        });


    });
</script>

